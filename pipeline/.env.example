# Copy to .env and fill in. Never commit .env.

# Supabase: Project Settings > Database > Connection string (use the pooler, port 6543)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# eodhd.com > Settings > API token
EODHD_API_TOKEN=

# Where raw downloads are kept (defaults shown)
RAW_DATA_DIR=data/raw
UNIVERSE_DIR=data/kompas100
TICKER_NAMES_FILE=data/ticker_names.csv
